# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test output
coverage/

# Environment files: never commit real secrets.
# The assignment requires secrets to live outside the code (Secrets Manager / SSM Parameter Store).
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example

# Keep the lock file for the application stack so provider versions are pinned.
!terraform/.terraform.lock.hcl

# The Lambda package produced by the archive_file data source is a build
# artefact, not source. Committing it would put a stale zip in the repository.
terraform/*.zip

# AWS SAM / Lambda local tooling
.aws-sam/

# Editor and OS noise
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
# Local Pi runtime state
.atl/
