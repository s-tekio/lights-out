# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test output
coverage/

# Environment files: never commit real secrets.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Keep the lock file for the application stack so provider versions are pinned.
!terraform/.terraform.lock.hcl

# The Lambda package produced by the archive_file data source is a build
# artefact, not source. Committing it would put a stale zip in the repository.
terraform/*.zip

# Editor and OS noise
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
# Local tool runtime state, not project source.
.atl/
